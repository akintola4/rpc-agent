{
  "name": "rpc-agent",
  "version": "0.3.1",
  "description": "Screenshot a URL at device viewports, optionally framed in device bezels. CLI and MCP server for AI coding agents.",
  "keywords": [
    "mcp",
    "mcp-server",
    "playwright",
    "claude-code",
    "cursor",
    "screenshot",
    "responsive",
    "device-mockup",
    "cli"
  ],
  "homepage": "https://github.com/akintola4/rpc-agent#readme",
  "bugs": {
    "url": "https://github.com/akintola4/rpc-agent/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akintola4/rpc-agent.git"
  },
  "license": "MIT",
  "author": "akintola4",
  "type": "module",
  "bin": {
    "rpc": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets",
    "NOTICE",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "rpc": "tsx src/cli.ts",
    "smoke:mcp": "tsx scripts/mcp-smoke.ts",
    "media": "pnpm build && tsx scripts/media/build.ts",
    "prepublishOnly": "pnpm typecheck && pnpm build && pnpm test"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "picocolors": "^1.1.1",
    "playwright": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@types/node": "^22.20.5",
    "@xterm/headless": "^5.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
