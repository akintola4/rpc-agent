{
  "name": "rpc-agent",
  "version": "0.2.0",
  "private": true,
  "description": "Screenshot a URL at device viewports, optionally framed in device bezels. CLI and MCP server for AI coding agents.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "rpc": "./dist/cli.js"
  },
  "files": [
    "dist",
    "assets",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "rpc": "tsx src/cli.ts",
    "smoke:mcp": "tsx scripts/mcp-smoke.ts",
    "media": "pnpm build && tsx scripts/media/build.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "picocolors": "^1.1.1",
    "playwright": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
